# ============================================
# TrafficIQ ML Service — Environment Variables
# ============================================

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/trafficiq?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883

# SUMO Simulator
SUMO_HOME=/usr/share/sumo

# Model Paths
MODEL_CHECKPOINT_PATH=./checkpoints/qmix_best.pt
YOLO_MODEL_PATH=./weights/yolov8n.pt

# Server
HOST=0.0.0.0
PORT=8000
